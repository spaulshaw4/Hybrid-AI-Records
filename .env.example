# ==========================================
# Hybrid AI Records — Production Env Template
# Copy to `.env.production` / host secrets. NEVER commit real values.
# TanStack Start / Vite: public client vars may also need `VITE_` mirrors.
# ==========================================

# ------------------------------------------
# SUPABASE CORE
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional aliases used by some server helpers:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# POSTGRES (Prisma 7 — urls live in prisma.config.ts, NOT schema.prisma)
# Runtime app → pooled. CLI migrate / db push → DIRECT_URL (preferred).
# ------------------------------------------
# Pooled (transaction) — high concurrency / Railway runtime:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct — Supabase Dashboard → Database → Connect → "Direct connection" (db.<ref>.supabase.co:5432):
# DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# Helper (reuses DATABASE_URL password + project ref, writes .env.local):
#   bun scripts/derive-direct-url.mjs
#   bunx prisma db push
#
# Note: user_vault.instrumental_url is managed by Supabase SQL migrations, not Prisma.

# ------------------------------------------
# APP URL & RUNTIME
# ------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# SITE_ORIGIN / LOCAL_VAULT_ORIGIN only for local/dev vault serving

# ------------------------------------------
# UPSTREAM MUSIC API (server-only)
# Prefer AIMUSICAPI_KEY; SHARED_API_KEY is accepted as an alias.
# ------------------------------------------
AIMUSICAPI_KEY=your-non-public-upstream-api-key
# SHARED_API_KEY=
# MUSICAPI_KEY=
# MUSIC_API_KEY=

# Provider switchboard for the generation queue worker
ACTIVE_GENERATION_PROVIDER=hybrid-engine
# ACTIVE_GENERATION_PROVIDER=third-party-wrapper

# ------------------------------------------
# CORTEX WORKER & QUEUE TUNING
# Web/ingress nodes: GENERATION_QUEUE_WORKER=external (or 0)
# Dedicated worker process: omit or leave unset; run `npm run worker:generation-jobs`
# ------------------------------------------
GENERATION_QUEUE_WORKER=external
GENERATION_QUEUE_THROTTLE_MS=3000
GENERATION_QUEUE_POLL_MS=2500

# ------------------------------------------
# ACTUATOR + MASTER ACTIVATOR SWITCH
# ------------------------------------------
ADMIN_ACTUATOR_SECRET=your-secure-random-admin-secret-string
ACTUATOR_FAILED_CRITICAL=15
ACTUATOR_PENDING_CONGESTED=50
ACTUATOR_PROCESSING_BACKLOG=25
# ACTUATOR_STUCK_JOB_MS=1800000
# PIPELINE_ACTIVATOR_CACHE_MS=10000
# Optional hard kill-switch without DB round-trip:
# PIPELINE_MASTER_STATE=ARMED
# PIPELINE_MASTER_STATE=MAINTENANCE
MAX_QUEUE_CAPACITY=100
# FREE_TIER_VELOCITY_LIMIT=5
# FREE_TIER_VELOCITY_WINDOW_MS=300000
# DEEP_ISOLATION_ENTANGLEMENT_CEILING=0.08
# MAX_NODE_CAPACITY=25
# REACTIVE_PLACEMENT_PRESSURE_THRESHOLD=1.5
# ACTUATOR_AUTO_TRIP=0

# ------------------------------------------
# OBSERVABILITY (optional)
# ------------------------------------------
# METRICS_TOKEN=your-prometheus-scrape-token

# ------------------------------------------
# PAYMENTS / EMAIL / OTHER (as required by your deploy)
# ------------------------------------------
# STRIPE_SECRET_KEY=
# VITE_PAYMENTS_CLIENT_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM=
# REPLICATE_API_TOKEN=
# GPU engine lyricist (user_track.py / POST /api/v2/user-track). Alias: REPLICATE_API_KEY.
# Optional Llama instruct override for replicate.run (default: meta/meta-llama-3-70b-instruct):
# REPLICATE_LYRICS_MODEL=meta/meta-llama-3-70b-instruct
# DEV_BYPASS_TOKENS=  # MUST be unset/false in production
# FIRECRAWL_API_KEY=  # optional; scrape works keyless at lower rate limits

# ------------------------------------------
# STEM INGEST / RENDER (GPU pod + stitch_engine)
# ------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# Public CDN for indexed stem URLs (not the S3 API host):
# R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=music-engine-stems
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# REDIS_URL=redis://localhost:6379/0
# Optional POST JSON destination when a mix finishes (or fails):
# RENDER_WEBHOOK_URL=
# FRONTEND_WEBHOOK_URL=
# HMAC-SHA256 for X-Hybrid-Signature on those POSTs. Leave unset to skip the header.
# WEBHOOK_SECRET=
# FRONTEND_WEBHOOK_SECRET=  # alias accepted by the engine
# Shared secret for POST /api/internal/broadcast (X-Internal-Token). Set this if
# the engine is reachable through a public proxy; loopback-only is otherwise allowed.
# INTERNAL_BROADCAST_TOKEN=
# LOCAL_DB_PATH=/workspace/hybrid_studio.db
# RUNPOD_API_KEY=
# RUNPOD_POD_ID=
