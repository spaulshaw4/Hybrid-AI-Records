// Prisma schema — Track pipeline state (gateMask, vault URLs, status).
//
// Prisma 7: `url` / `directUrl` are NOT allowed here.
// Equivalent of:
//   url       = env("DATABASE_URL")   → PrismaClient runtime (pooled)
//   directUrl = env("DIRECT_URL")     → prisma.config.ts CLI / migrate
// See prisma.config.ts

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Track {
  id           String   @id @default(uuid())
  title        String
  prompt       String
  gateMask     Int      @default(0)
  status       String   @default("QUEUED")
  rawAudioUrl  String?
  stemsUrl     String?
  masterUrl    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
