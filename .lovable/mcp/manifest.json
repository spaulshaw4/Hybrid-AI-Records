{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://burekqrybggjzbwnpnfo.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "hybrid-ai-forge",
      "version": "0.1.0",
      "title": "Hybrid AI Forge"
    },
    "tools": [
      {
        "name": "list_vocal_sessions",
        "title": "List vocal sessions",
        "description": "List vocal session booking requests (artist, email, timezone, status, confirmed slot). Staff access only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return bookings in this status. Omit to return every status.",
              "type": "string",
              "enum": [
                "requested",
                "confirmed",
                "rescheduled",
                "declined",
                "cancelled"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of rows to return. Between 1 and 100; defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Vocal session request id (UUID)."
                  },
                  "artist": {
                    "type": "string",
                    "description": "Artist name supplied on the booking."
                  },
                  "email": {
                    "type": "string",
                    "description": "Contact email for the booking."
                  },
                  "timezone": {
                    "type": "string",
                    "description": "IANA timezone the artist selected, e.g. America/New_York."
                  },
                  "package_label": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Human-readable package the session belongs to."
                  },
                  "status": {
                    "type": "string",
                    "description": "Booking status: requested, confirmed, rescheduled, declined or cancelled."
                  },
                  "confirmed_slot": {
                    "anyOf": [
                      {},
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Confirmed slot object, or null while pending."
                  },
                  "meeting_link": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Generated video-chat link for the session."
                  },
                  "created_at": {
                    "type": "string",
                    "description": "ISO 8601 timestamp (UTC)."
                  }
                },
                "required": [
                  "id",
                  "artist",
                  "email",
                  "timezone",
                  "package_label",
                  "status",
                  "confirmed_slot",
                  "meeting_link",
                  "created_at"
                ]
              },
              "description": "Matching vocal session bookings, newest first."
            }
          },
          "required": [
            "sessions"
          ]
        }
      },
      {
        "name": "list_session_emails",
        "title": "List session notification emails",
        "description": "List the notification email delivery log for vocal sessions, including subject, recipient and outcome. Staff access only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "outcome": {
              "description": "Only return emails with this delivery outcome. Omit for all outcomes.",
              "type": "string",
              "enum": [
                "sent",
                "failed",
                "pending"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of rows to return. Between 1 and 100; defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "emails": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Email log entry id (UUID)."
                  },
                  "request_id": {
                    "type": "string",
                    "description": "Vocal session request this email belongs to."
                  },
                  "kind": {
                    "type": "string",
                    "description": "Notification type, e.g. request or confirmation."
                  },
                  "recipient": {
                    "type": "string",
                    "description": "Address the email was sent to."
                  },
                  "subject": {
                    "type": "string",
                    "description": "Email subject line."
                  },
                  "outcome": {
                    "type": "string",
                    "description": "Delivery outcome: sent, failed or pending."
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Failure reason when the outcome is not sent."
                  },
                  "created_at": {
                    "type": "string",
                    "description": "ISO 8601 timestamp (UTC)."
                  }
                },
                "required": [
                  "id",
                  "request_id",
                  "kind",
                  "recipient",
                  "subject",
                  "outcome",
                  "reason",
                  "created_at"
                ]
              },
              "description": "Matching email log entries, newest first."
            }
          },
          "required": [
            "emails"
          ]
        }
      },
      {
        "name": "list_lyrics_submissions",
        "title": "List lyrics submissions",
        "description": "List artist lyrics submissions with package, language and status. Staff access only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "language": {
              "description": "Only return submissions in this language, e.g. English.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of rows to return. Between 1 and 100; defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "submissions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Lyrics submission id (UUID)."
                  },
                  "artist": {
                    "type": "string",
                    "description": "Artist name."
                  },
                  "email": {
                    "type": "string",
                    "description": "Contact email."
                  },
                  "package_label": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Package the lyrics were submitted against."
                  },
                  "language": {
                    "type": "string",
                    "description": "Language of the submitted lyrics."
                  },
                  "file_name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Uploaded lyrics file name, if any."
                  },
                  "status": {
                    "type": "string",
                    "description": "Review status, e.g. received."
                  },
                  "created_at": {
                    "type": "string",
                    "description": "ISO 8601 timestamp (UTC)."
                  }
                },
                "required": [
                  "id",
                  "artist",
                  "email",
                  "package_label",
                  "language",
                  "file_name",
                  "status",
                  "created_at"
                ]
              },
              "description": "Matching lyrics submissions, newest first."
            }
          },
          "required": [
            "submissions"
          ]
        }
      },
      {
        "name": "list_upload_audit_log",
        "title": "List upload audit log",
        "description": "List artist file upload, replace and delete actions with order reference and outcome. Staff access only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "action": {
              "description": "Only return entries for this action. Omit for all actions.",
              "type": "string",
              "enum": [
                "upload",
                "replace",
                "delete"
              ]
            },
            "outcome": {
              "description": "Only return entries with this outcome. Omit for all outcomes.",
              "type": "string",
              "enum": [
                "success",
                "failed"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of rows to return. Between 1 and 100; defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Audit entry id (UUID)."
                  },
                  "action": {
                    "type": "string",
                    "description": "Action performed: upload, replace or delete."
                  },
                  "bucket": {
                    "type": "string",
                    "description": "Storage bucket name."
                  },
                  "object_path": {
                    "type": "string",
                    "description": "Path of the object inside the bucket."
                  },
                  "file_name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Original file name."
                  },
                  "file_size": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "File size in bytes."
                  },
                  "reference_code": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Order/track reference the file belongs to."
                  },
                  "outcome": {
                    "type": "string",
                    "description": "Result of the action: success or failed."
                  },
                  "error_message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Error detail when the action failed."
                  },
                  "created_at": {
                    "type": "string",
                    "description": "ISO 8601 timestamp (UTC)."
                  }
                },
                "required": [
                  "id",
                  "action",
                  "bucket",
                  "object_path",
                  "file_name",
                  "file_size",
                  "reference_code",
                  "outcome",
                  "error_message",
                  "created_at"
                ]
              },
              "description": "Matching audit log entries, newest first."
            }
          },
          "required": [
            "entries"
          ]
        }
      }
    ]
  }
}
