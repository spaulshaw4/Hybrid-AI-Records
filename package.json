{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "start": "bun .output/server/index.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . || exit 0",
    "format": "prettier --write .",
    "social:sync": "python3 scripts/social_pipeline.py",
    "social:sync:force": "python3 scripts/social_pipeline.py --force",
    "social:check": "python3 scripts/social_pipeline.py --check",
    "social:watch": "python3 scripts/social_pipeline.py --watch",
    "upload:vault": "tsx scripts/batch-upload-vault.ts",
    "sync:catalog": "tsx scripts/sync-artist-catalog.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/test/division-crest-axe.test.tsx src/test/division-crest-a11y.test.tsx src/test/sync-badge-axe.test.tsx",
    "test:security": "vitest run src/test/site-origin.test.ts",
    "test:payments": "vitest run src/test/zar-checkout-amounts.test.ts src/test/surcharge-rounding.test.ts src/test/stripe-webhook-return.test.ts src/test/return-page-zar-format.test.ts src/test/payment-outcome.test.ts src/test/money-format.test.ts",
    "test:e2e:background": "playwright test e2e/living-background-stacking.spec.ts --project=chromium",
    "test:e2e:a11y:transitions": "playwright test e2e/sync-badge-axe-transitions.spec.ts --project=chromium",
    "test:e2e:a11y:qr": "playwright test e2e/order-qr-axe.spec.ts e2e/order-qr-focus-trap.spec.ts e2e/order-qr-keyboard.spec.ts --project=chromium",
    "test:e2e:a11y:qr:mobile": "playwright test e2e/order-qr-focus.mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:e2e:a11y": "playwright test e2e/sync-badge-axe.spec.ts e2e/sync-badge-contrast.spec.ts e2e/sync-badge-sr.spec.ts e2e/sync-badge-pointer.spec.ts e2e/sync-badge-keyboard.spec.ts e2e/sync-badge-tooltip-refocus.spec.ts e2e/sync-badge-reduced-motion.spec.ts --project=chromium",
    "test:e2e:a11y:refocus": "playwright test e2e/sync-badge-tooltip-refocus.spec.ts --project=chromium --workers=1",
    "test:e2e:a11y:touch:ios": "playwright test e2e/sync-badge-touch-ios.mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:e2e:a11y:motion-contrast": "playwright test e2e/sync-badge-motion-contrast.mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:e2e:a11y:voiceover": "playwright test e2e/sync-badge-voiceover.mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:e2e:a11y:mobile": "playwright test e2e/sync-badge-touch.mobile.spec.ts e2e/sync-badge-keyboard.mobile.spec.ts e2e/sync-badge-axe.mobile.spec.ts e2e/sync-badge-tooltip-anchor.mobile.spec.ts --project=mobile-chrome",
    "test:a11y:safari": "python3 e2e/tools/verify-safari-axe.py && python3 e2e/tools/verify-safari-keyboard.py",
    "test:e2e:a11y:order": "playwright test e2e/order-a11y.spec.ts e2e/homepage-keyboard.spec.ts e2e/reduced-motion-order.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "test:e2e:ios:redirect": "playwright test e2e/engine-ios-payment-redirect.mobile.spec.ts --project=mobile-chrome --project=mobile-safari --workers=1",
    "test:e2e:mobile": "playwright test e2e/division-crest-mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ios:overlays": "playwright test e2e/overlay-frozen-tiles.mobile.spec.ts --project=mobile-safari --project=mobile-chrome --workers=1"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
