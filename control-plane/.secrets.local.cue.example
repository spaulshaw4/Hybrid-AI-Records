// Local-development secrets for `encore run`. Copy to `.secrets.local.cue`
// (git-ignored). In Encore Cloud set each with:
//   encore secret set --type dev,prod <Name>

// Clients (dashboard, scripts) send this as the X-API-Key header.
DashboardAPIKey: "change-me-local-dashboard-key"

// Encore -> Python DSP worker (api/headless_job_runner.py). Cloud environments
// cannot reach 127.0.0.1: use a stable tunnel / private-network URL there.
WorkerBaseURL: "http://127.0.0.1:8880"
// Must equal HYBRID_WORKER_TOKEN on the worker ("" when the worker has none).
WorkerToken: ""

// Python worker -> Encore (callbacks, upload-URL requests). Must equal
// HYBRID_WORKER_SHARED_SECRET on the worker; sent as X-Worker-Secret.
WorkerSharedSecret: "change-me-local-worker-shared-secret"

// Slack incoming webhook. Empty string disables Slack posts.
SlackWebhookURL: ""

// S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
// R2: S3Endpoint "https://<account_id>.r2.cloudflarestorage.com", S3Region "auto".
// AWS: S3Endpoint "" and the bucket's region, e.g. "us-east-1".
S3Endpoint: ""
S3Region: "auto"
S3AccessKeyId: ""
S3SecretAccessKey: ""
S3BucketName: "hybrid-deliveries"
